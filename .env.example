GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
CANDIDATE_K=24
COLLECT_LIMIT=6
# 공식 수집기의 운영자 연락처 (필요한 경우 URL/이메일, 공개 User-Agent에 포함됨)
SOURCE_CONTACT=

# 기본은 세션 모의 접수. 실제 GM/공식 고객센터로 전송하지 않음.
TICKET_TRANSPORT=demo
# 직접 소유/승인한 수신처에 연결할 때만 email 또는 webhook으로 변경.
TICKET_EMAIL_TO=
TICKET_EMAIL_FROM=
TICKET_SMTP_HOST=
TICKET_SMTP_PORT=465
TICKET_SMTP_USER=
TICKET_SMTP_PASSWORD=
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_TOKEN=
